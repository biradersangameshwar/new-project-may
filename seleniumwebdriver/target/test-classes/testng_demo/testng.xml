<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ProjectSuite" parallel="methods" thread-count="3">
    <parameter name="browser" value="chrome"/>
    
    <test name="LoginTests">
        <classes>
            <class name="testng_demo.Login">
                <methods>
                    <include name="validLogin"/>
                    <include name="invalidLogin"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="SearchTests">
        <classes>
            <class name="testng_demo.SearchTest"/>
        </classes>
    </test>

    <test name="OrderTests">
        <classes>
            <class name="testng_demo.OrderPlacementTest"/>
        </classes>
    </test>
</suite>

